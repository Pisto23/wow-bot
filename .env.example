# Kopieren nach .env und ausfüllen. .env NIEMALS committen.

# Discord Bot Token (Discord Developer Portal -> Bot -> Token)
DISCORD_TOKEN=

# wowaudit API-Keys — pro Team, sichtbar für Team-Admins unter
# https://wowaudit.com/<region>/<realm>/<gilde>/<team>/api
RAID1_WOWAUDIT_KEY=
RAID2_WOWAUDIT_KEY=
